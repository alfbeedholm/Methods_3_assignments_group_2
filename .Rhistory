knitr::opts_chunk$set(echo = TRUE)
pacman::p_load(tidyverse, readbulk, patchwork, lmerTest)
data <- read_bulk(
directory = "experiment_2/",
fun = read_csv,
col_types = cols()
)
data.count <- data %>%
group_by(subject, task, pas) %>%
count() %>%
rename(count = n) %>%
mutate(pas = factor(pas),
task = factor(task),
subject = factor(subject))
mlm <- lme4::glmer(count ~ pas*task + (pas | subject), data = data.count, family = poisson)
View(data.count)
